<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h3>About {{ shop.name }}</h3>
        <p>Freshly baked cakes and scones made with love. Handcrafted quality in every bite.</p>
      </div>
      <div class="footer-section">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="/collections/all">Shop</a></li>
          <li><a href="{{ routes.account_url }}">Account</a></li>
          <li><a href="#">Contact</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Customer Service</h3>
        <ul>
          <li><a href="#">Shipping Info</a></li>
          <li><a href="#">Returns</a></li>
          <li><a href="#">FAQ</a></li>
          <li><a href="#">Privacy Policy</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Stay Connected</h3>
        <p>Subscribe to our newsletter for fresh updates and special offers.</p>
        <form class="newsletter-form">
          <input type="email" placeholder="Your email" required>
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {{ "now" | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
      <div class="footer-links">
        <a href="#">Terms</a>
        <a href="#">Privacy</a>
        <a href="#">Cookies</a>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    background-color: var(--color-primary);
    color: var(--color-text-secondary, #e0e0e0);
    padding: 3rem 0 1rem;
    margin-top: 3rem;
    border-top: 1px solid #222;
  }
  
  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }
  
  .footer-section h3 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--color-accent);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
  }
  
  .footer-section p {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  
  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-section ul li {
    margin-bottom: 0.75rem;
  }
  
  .footer-section a {
    color: #e0e0e0;
    text-decoration: none;
    transition: color 0.3s ease;
    font-size: 0.9rem;
  }
  
  .footer-section a:hover {
    color: var(--color-accent);
  }
  
  /* Newsletter form */
  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }
  
  .newsletter-form input {
    flex: 1;
    padding: 0.7rem;
    background-color: #1a1a1a;
    border: 1px solid #333;
    color: #ffffff;
    border-radius: 4px 0 0 4px;
    font-size: 0.9rem;
  }
  
  .newsletter-form input::placeholder {
    color: #999;
  }
  
  .newsletter-form input:focus {
    outline: none;
    border-color: #555;
  }
  
  .newsletter-form button {
    padding: 0.7rem 1.25rem;
    background-color: #ffffff;
    color: #000;
    border: none;
    border-radius: 0 4px 4px 0;
    cursor: pointer;
    font-weight: 600;
    transition: background-color 0.3s ease;
    font-size: 0.9rem;
  }
  
  .newsletter-form button:hover {
    background-color: #e0e0e0;
  }
  
  /* Footer bottom */
  .footer-bottom {
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid #222;
    font-size: 0.85rem;
    color: #999;
  }
  
  .footer-bottom p {
    margin: 0 0 1rem 0;
  }
  
  .footer-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }
  
  .footer-links a {
    color: #999;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .footer-links a:hover {
    color: var(--color-accent);
  }
  
  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .footer {
      padding: 2rem 0 1rem;
    }
    
    .footer-content {
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
    
    .footer-section h3 {
      font-size: 0.95rem;
    }
    
    .newsletter-form {
      flex-direction: column;
    }
    
    .newsletter-form input {
      border-radius: 4px;
    }
    
    .newsletter-form button {
      border-radius: 4px;
    }
    
    .footer-links {
      gap: 1rem;
      font-size: 0.8rem;
    }
  }
  
  @media (max-width: 480px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .footer-section h3 {
      font-size: 0.9rem;
    }
    
    .footer-section p {
      font-size: 0.85rem;
    }
    
    .footer-section a {
      font-size: 0.85rem;
    }
  }
{% endstylesheet %}
